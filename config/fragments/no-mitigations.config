# Disable ALL CPU mitigations - AMD Jaguar is NOT affected by Spectre/Meltdown
# These add code complexity and page table overhead that can break kexec boot
# Use bootarg mitigations=off as belt-and-suspenders

# KPTI (Kernel Page Table Isolation) - doubles page table structures
# CONFIG_MITIGATION_PAGE_TABLE_ISOLATION is not set

# Retpoline/Rethunk - modifies indirect call/return sequences
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_MITIGATION_RETHUNK is not set

# AMD-specific mitigations - not needed on Jaguar
# CONFIG_MITIGATION_UNRET_ENTRY is not set
# CONFIG_MITIGATION_IBPB_ENTRY is not set
# CONFIG_MITIGATION_SRSO is not set
# CONFIG_MITIGATION_RETBLEED is not set

# Spectre v1/v2
# CONFIG_MITIGATION_SPECTRE_V1 is not set
# CONFIG_MITIGATION_SPECTRE_V2 is not set

# SSB (Speculative Store Bypass)
# CONFIG_MITIGATION_SSB is not set

# SLS (Straight Line Speculation)
# CONFIG_MITIGATION_SLS is not set
