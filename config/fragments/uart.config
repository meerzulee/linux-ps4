# UART Serial Console Configuration Fragment
# For PS4 Baikal southbridge UART hardware mod
#
# Enables serial console output alongside HDMI (tty0)
# Use bootargs: console=tty0 console=ttyS0,115200n8

# 8250/16550 serial driver (standard PC UART)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Console polling (for kgdb/serial debug)
CONFIG_CONSOLE_POLL=y

# Early printk via serial
CONFIG_EARLY_PRINTK=y

# Kernel serial console support
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# TTY layer
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
