# Experimental PS4 Baikal MTS in-tree MODULE target.
# Same v6.18.44 pin and 54 base patches; isolated release/output/config.
# Explicit post-boot load only after baikal_pcie is bound; no autoload/activation.
# Publication retains code/DMA/maps and permits only one open; fixed 900s lease.

TARGET_NAME="6.18-baikal-mts"
BASE_REPO="https://github.com/gregkh/linux.git"
BASE_REF="v6.18.44"
BASE_COMMIT="1efe5d048a391de3ead2804b2e7f86376c356cc5"
BASE_DEPTH=1
CONFIG_FILE="config/6.18-baikal-mts.config"
SERIES_FILE="patches/6.18-baikal-mts/series"
PATCHES_DIR="patches/6.18-baikal-mts"
# Keep release inputs explicit. Debug options are already represented in the
# full config and can later move to a separate development target.
# Preserve the hardware-tested NETFILTER=n state; the regular target
# also merges netfilter-ufw, which is deliberately outside this MTS test.
CONFIG_FRAGMENTS="config/fragments/mt7668.config config/fragments/usb-ethernet.config"
COMPILER="gcc"

# Release builds must not inherit the container ID, wall clock or incremental
# .version counter. These values are part of the bzImage bytes and therefore
# part of the FPKG/USB module-pairing contract.
SOURCE_DATE_EPOCH=1786233600
KBUILD_RELEASE_TIMESTAMP="2026-08-09 00:00:00 UTC"
KBUILD_RELEASE_USER="omarchy-ps4"
KBUILD_RELEASE_HOST="orb-builder"
KBUILD_RELEASE_VERSION=1
