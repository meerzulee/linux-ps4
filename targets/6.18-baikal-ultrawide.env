# Experimental PS4 Baikal native-ultrawide target.
#
# This target deliberately has a unique kernel release and output directory so
# it cannot overwrite or masquerade as the accepted 1080p60 rollback kernel.

TARGET_NAME="6.18-baikal-ultrawide"
BASE_REPO="https://github.com/gregkh/linux.git"
BASE_REF="v6.18.44"
BASE_COMMIT="1efe5d048a391de3ead2804b2e7f86376c356cc5"
BASE_DEPTH=1
CONFIG_FILE="config/6.18-baikal.config"
SERIES_FILE="patches/6.18-baikal-ultrawide/series"
PATCHES_DIR="patches/6.18-baikal-ultrawide"
CONFIG_FRAGMENTS="config/fragments/mt7668.config config/fragments/usb-ethernet.config config/fragments/netfilter-ufw.config config/fragments/ultrawide-3440x1440.config"
COMPILER="gcc"

SOURCE_DATE_EPOCH=1786233600
KBUILD_RELEASE_TIMESTAMP="2026-08-09 00:00:00 UTC"
KBUILD_RELEASE_USER="omarchy-ps4"
KBUILD_RELEASE_HOST="orb-builder"
KBUILD_RELEASE_VERSION=1

