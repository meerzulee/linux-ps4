# Target: PS4 Baikal on Linux 6.18.44 LTS
#
# Base = kernel.org stable v6.18.44, pinned to the peeled tag commit below.
# All Baikal-specific code arrives through patches/6.18-baikal/. The initial
# series is ported from the hardware-tested 6.15.4 target; every adjustment
# for 6.18 lives in this target rather than modifying the old fallback.
#
# Hardware support is not inherited merely because this target builds. It must
# pass the repository's Baikal cold-boot and regression gates.

TARGET_NAME="6.18-baikal"
BASE_REPO="https://github.com/gregkh/linux.git"
BASE_REF="v6.18.44"
BASE_COMMIT="1efe5d048a391de3ead2804b2e7f86376c356cc5"
BASE_DEPTH=1
CONFIG_FILE="config/6.18-baikal.config"
SERIES_FILE="patches/6.18-baikal/series"
PATCHES_DIR="patches/6.18-baikal"
# Keep release inputs explicit. Debug options are already represented in the
# full config and can later move to a separate development target.
CONFIG_FRAGMENTS="config/fragments/mt7668.config config/fragments/usb-ethernet.config config/fragments/netfilter-ufw.config"
COMPILER="gcc"
